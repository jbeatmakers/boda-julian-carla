[Unit]
Description=Boda Julián & Carla API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=boda-wedding
Group=boda-wedding
WorkingDirectory=/opt/boda-julian-carla/server
EnvironmentFile=/etc/boda-julian-carla.env
ExecStart=/usr/bin/python3 /opt/boda-julian-carla/server/app.py
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/boda-julian-carla
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
MemoryDenyWriteExecute=true
UMask=0077

[Install]
WantedBy=multi-user.target
